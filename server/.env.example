# Copia in server/.env e compila. Il file .env non va MAI committato.
SUPABASE_URL=https://fxnfaotahrlmmrundkib.supabase.co
# Chiave "service_role" (Supabase → Project Settings → API). Solo lato server.
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
# Cartella del frontend compilato da servire in produzione (opzionale)
STATIC_DIR=../web/dist
# Codice del Banco di Regia (pagina /regia). Scegline uno tuo di almeno 12 caratteri e mettilo solo nel .env del server.
# Questo è un valore finto: con questo valore, o vuoto, o più corto di 8 caratteri la Regia resta disattivata.
ADMIN_CODE=metti-qui-un-codice-tuo
# Notifiche push (vedi docs/notifiche.md). Chiavi con:  npx web-push generate-vapid-keys
# Questi sono valori finti: senza chiavi vere (o con PUSH_ENABLED=false) le notifiche restano spente e il gioco funziona uguale.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tuo-indirizzo@esempio.it
PUSH_ENABLED=true
PUSH_B_PER_TEAM_COOLDOWN_SEC=120
